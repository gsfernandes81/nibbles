__pycache__/
*.pyc

# Runtime state of the runner. The queue is tracked (the jobs are source);
# everything the runner writes about them is not.
done/
failed/
heartbeat
logs/
out/
work/
runner.lock
state.json
# Where this device puts finished downloads. Per-device by definition.
config.json

# uv-managed dev environment (make dev)
.venv/
.pytest_cache/
.hypothesis/

# make mutants: poodle's per-worker copies of the tree, and its report
.poodle-temp/
.poodle-report.json

# uv build
dist/

# The runner launcher nibbles.home writes into the queue root, a checkout
# included: it names the package's path, which is this machine's.
/expire_runner.py
